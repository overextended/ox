{
  "name": "@overextended/core",
  "version": "0.0.6",
  "devDependencies": {
    "@types/bun": "latest",
    "mitata": "^1.0.34",
    "prettier": "3.6.2",
    "standard-version": "^9.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --build --clean && tsc --build",
    "format": "bunx prettier . --write",
    "release": "bun format && bun run build && bun standard-version --skip.changelog && bun publish"
  }
}
